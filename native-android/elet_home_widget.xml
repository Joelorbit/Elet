<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/elet_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/elet_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Elet • ዕለት"
        android:textColor="#8E4424"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Quick access"
        android:textColor="#62564D"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/elet_widget_prayer"
            style="@style/EletWidgetAction"
            android:contentDescription="Open prayer hours"
            android:text="Prayer" />

        <TextView
            android:id="@+id/elet_widget_calendar"
            style="@style/EletWidgetAction"
            android:contentDescription="Open the calendar"
            android:text="Calendar" />

        <TextView
            android:id="@+id/elet_widget_scripture"
            style="@style/EletWidgetAction"
            android:contentDescription="Open daily scripture"
            android:text="Scripture" />
    </LinearLayout>
</LinearLayout>
